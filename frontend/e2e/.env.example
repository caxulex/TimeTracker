# ============================================
# E2E Test Environment Variables
# ============================================
# Copy this file to .env and fill in values matching your seeded test data.
#
# These credentials should match the demo data created by:
#   backend/scripts/seed_demo_data.py
#
# NEVER use production credentials here.
# ============================================

# Base URL of the running application
BASE_URL=http://localhost:5173

# API URL (backend)
API_URL=http://localhost:8080

# Regular test user credentials
TEST_USER_EMAIL=demo@example.com
TEST_USER_PASSWORD=DemoPass123!
TEST_USER_NAME=Demo User

# Admin test user credentials
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPass123!
TEST_ADMIN_NAME=Admin User

# Multi-tenant test user (company 2 / XYZ Corp)
TEST_COMPANY2_EMAIL=user@xyz-corp.com
TEST_COMPANY2_PASSWORD=XyzPass123!
TEST_COMPANY2_SLUG=xyz-corp

# App-specific test user (app.spec.ts)
TEST_APP_USER_EMAIL=e2e-test@example.com
TEST_APP_USER_PASSWORD=TestPassword123!
TEST_APP_USER_NAME=E2E Test User
